{
  "entity_name": {
    "description": "AI 实体在游戏里的登录名",
    "type": "string",
    "default": "",
    "hint": "与 mineflayer 的 MC_USERNAME 一致。按名字精确匹配，不区分大小写。⚠️ 留空则它自己的发言也会进 {events}"
  },
  "server_address": {
    "description": "MC 服务器地址",
    "type": "string",
    "default": "",
    "hint": "只写进提示词，插件不连它"
  },
  "server_port": {
    "description": "MC 服务器端口",
    "type": "int",
    "default": 25565,
    "hint": "只写进提示词，插件不连它"
  },
  "watch_tasks": {
    "description": "轮询任务",
    "type": "template_list",
    "hint": "每条任务按自己的时间把期间的动态交给 AI。AI 建的任务也在这里。⚠️ session 留空则该条不触发",
    "templates": {
      "event_poll": {
        "name": "事件轮询",
        "hint": "到点后把这段时间的游戏内动态交给 AI，由她决定说不说话",
        "display_item": "name",
        "items": {
          "name": {
            "description": "名称",
            "type": "string",
            "default": "事件轮询",
            "hint": "折叠时显示这一条"
          },
          "cron": {
            "description": "时间",
            "type": "string",
            "default": "*/30 * * * *",
            "hint": "5 字段：分 时 日 月 周。如 0 9 * * * = 每天 9 点，*/30 * * * * = 每 30 分钟"
          },
          "types": {
            "description": "推送哪些游戏内动态",
            "type": "list",
            "default": [
              "chat",
              "whisper",
              "playerJoined",
              "playerLeft",
              "death",
              "message",
              "weatherUpdate"
            ],
            "hint": "勾选要交给 AI 的动态。默认 7 项够日常用。⚠️ health 每次血量或饥饿变化都触发，entityHurt 与 entitySpawn 在刷怪塔里一趟上百条，开了会挤占其他事件",
            "render_type": "checkbox",
            "options": [
              "chat",
              "whisper",
              "playerJoined",
              "playerLeft",
              "death",
              "message",
              "weatherUpdate",
              "login",
              "experience",
              "goal_reached",
              "path_reset",
              "actionBar",
              "title",
              "spawn",
              "respawn",
              "breath",
              "heldItemChanged",
              "health",
              "entityHurt",
              "entityDead",
              "entitySpawn",
              "entityGone",
              "itemDrop",
              "soundEffectHeard",
              "diggingCompleted",
              "diggingAborted",
              "blockPlaced",
              "mount",
              "dismount",
              "sleep",
              "wake",
              "windowOpen",
              "windowClose",
              "rain",
              "bossBarCreated",
              "bossBarDeleted",
              "resourcePack",
              "error",
              "forcedMove",
              "spawnReset",
              "playerCollect",
              "entityEffect",
              "entityAttach",
              "entityDetach",
              "entityEquip",
              "entitySwingArm",
              "entitySleep",
              "entityWake",
              "entityCrouch",
              "entityUncrouch",
              "entityHandSwap",
              "entityElytraFlew",
              "entityTaming",
              "entityTamed",
              "usedFirework",
              "goal_updated",
              "pvp_stopped",
              "autoeat_start",
              "autoeat_finish",
              "autoeat_fail"
            ],
            "labels": [
              "玩家发言",
              "私聊你",
              "有人进服",
              "有人退服",
              "你自己死了",
              "系统消息(含跨服与QQ转发)",
              "天气变化",
              "你自己上线",
              "升级",
              "行动完成",
              "寻路被重置",
              "动作栏文字",
              "标题文字",
              "你出生或进入世界",
              "你重生",
              "氧气变化",
              "切换手持物",
              "血量与饥饿",
              "附近实体受伤",
              "附近实体死亡",
              "附近生成实体",
              "附近实体消失",
              "附近掉落物",
              "附近的音效",
              "挖掉方块",
              "挖掘中断",
              "放下方块",
              "骑上载具",
              "离开载具",
              "你上床",
              "你起床",
              "打开容器",
              "关闭容器",
              "开始或停止下雨",
              "Boss血条出现",
              "Boss血条消失",
              "收到资源包",
              "客户端错误",
              "被强制移动",
              "重生点重置",
              "你捡到东西",
              "实体获得状态效果",
              "实体上车",
              "实体下车",
              "实体换装备",
              "实体挥臂",
              "实体入睡",
              "实体醒来",
              "实体下蹲",
              "实体起身",
              "实体换手",
              "实体鞘翅飞行",
              "实体驯服中",
              "实体被驯服",
              "使用烟花",
              "行动目标更新",
              "战斗结束",
              "开始自动进食",
              "自动进食完成",
              "自动进食失败"
            ]
          },
          "prompt": {
            "description": "内容",
            "type": "text",
            "default": "下面是最近的游戏内动态:\n{events}\n\n说明:\n- 以 <名字> 开头的是游戏内玩家发言\n- 带 [服务器名] 的是其他服务器的动态,群里看不到\n- 带 ⌜群名⌟ 的是 QQ 群消息转发进游戏的,群里已经发生过了,不要重复回复\n- 叫的是你才回应,不确定就保持安静\n- 要让游戏里的玩家看到,用 chat 工具说;想同时让群里知道,就在群里也说一句\n- 没有值得说的,调用 ai_being_stay_silent 工具,本次回复不会发送\n  也可以只回复 [静默] 达到同样效果\n",
            "hint": "占位符：{events} 期间事件、{entity} 它的名字、{server} 服务器地址、{time} 当前时间。要写字面量花括号时写成 {{ 与 }}"
          },
          "session": {
            "description": "投递会话",
            "type": "string",
            "default": "",
            "hint": "形如 aiocqhttp:GroupMessage:123456789。平台标识是面板上机器人的 ID，不是适配器名。⚠️ 留空则该条永不触发"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true,
            "hint": "关闭后到点也不触发"
          },
          "quiet_hours": {
            "description": "静默时段",
            "type": "string",
            "default": "",
            "hint": "整点区间，含头不含尾，如 0-7；支持跨午夜 22-2。留空不静默。只压制定时触发"
          },
          "created_by": {
            "description": "创建者",
            "type": "string",
            "default": "",
            "invisible": true,
            "hint": "ai = 由 AI 建立,它可以自己删;留空 = 手填,只能停用"
          },
          "offline_policy": {
            "description": "它不在游戏里时怎么办",
            "type": "string",
            "options": [
              "annotate",
              "skip"
            ],
            "labels": [
              "照常触发并告知不在线",
              "跳过不触发"
            ],
            "default": "annotate",
            "hint": "触发前先查一次连接状态。照常触发:提示词里会写明不在线,AI 不会以为自己在游戏里;跳过:这一轮直接不触发。⚠️ 连接状态查不出来时按「不在线」处理"
          }
        }
      }
    },
    "default": []
  }
}
